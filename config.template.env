# Agent Box Configuration

# --- GitHub Configuration ---
# List of repositories to watch (comma-separated)
# Example: "owner/repo1,owner/repo2"
GITHUB_REPOS="owner/repository_name"

# The GitHub user executing the agents
# (This is primarily for logging/logic, actual auth is handled by 'gh auth login')
GITHUB_USER="pr-gemini"

# Git Identity (for commits made by the agent)
GIT_NAME="Agent Gemini"
GIT_EMAIL="agent@example.com"

# --- Watcher Configuration ---
# Log Level: INFO or DEBUG
LOG_LEVEL=INFO

# --- Log Files ---
# Logs are written to:
#   - agent_watcher.log  (main agent logs)
#   - supervisor.log     (supervisor logs)
#   - audit.log          (structured audit trail, JSON Lines)

# How often to check for new issues (in seconds)
# How often to check for new issues (in seconds)
POLL_INTERVAL=60

# Self-Update Check Interval
# How often the agent-watcher should check for its own updates (git pull) in seconds.
# Default: 3600 (1 hour)
SELF_UPDATE_INTERVAL=3600

# Directory where the agent will clone the repo and work
# Defaults to a 'workspace' folder inside the install dir if not absolute
# Directory where the agent will clone the repo and work
# Defaults to a 'workspace' folder inside the install dir if not absolute
WORK_DIR_BASE="workspace"

# Branch Naming Strategy
# Supports placeholders: {number}, {title}, {safe_title}
# Example: feat/issue-{number}-{safe_title}
# Note: Issues starting with "Phase X" will strictly follow "feat/phase{N}-{name}"
# regardless of this template, to comply with GEMINI.md.
BRANCH_NAME_TEMPLATE="feat/issue-{number}-{safe_title}"

# PR Base Branch
# The default branch to target for PRs (e.g. develop, main)
# Agents can override this if "PR Target: <branch>" is found in the issue body.
PR_BASE_BRANCH="develop"

# --- Trigger Logic ---
# The agent now triggers on assignment to GITHUB_USER
# TRIGGER_LABEL="status:pending-agent"

# Label applied when agent starts working
WIP_LABEL="status:agent-working"

# Label applied when agent is done
DONE_LABEL="status:agent-done"

# Label applied when agent needs to address reviews
REVIEW_LABEL="status:agent-review"

# Label applied if agent fails
ERROR_LABEL="status:agent-failed"

# --- Agent Command ---
# The command to execute when a job is found.
# Supported placeholders:
#   {issue_url}  - The full URL of the issue
#   {issue_number} - The issue number
#   {workspace_dir} - The directory where the repo is checked out
#
# Examples:
# AGENT_COMMAND="claude --print-architecture --issue {issue_url}"
# AGENT_COMMAND="claude --print-architecture --issue {issue_url}"
# AGENT_COMMAND="gemini --yolo \"Fix the issue described in @CURRENT_ISSUE.md. Follow @GEMINI.md.\""
AGENT_COMMAND="gemini --yolo \"Fix the issue described in @CURRENT_ISSUE.md. IMPORTANT: Read @GEMINI.md first. strict adhere to Branching Policy: Check for existing PR/Branch for this issue before creating new one.\""

# Optional: Dedicated command for Review/Feedback loops
# If set, this command is used when addressing review comments (status:agent-review).
# If not set, AGENT_COMMAND is used with an appended instruction to check comments.
# AGENT_REVIEW_COMMAND="gemini --yolo \"Fix the review comments in @PR_CONTEXT.md. Do not deviate from the requested changes.\""

# --- Environment Secrets ---
# API Keys for your agents
# Google / Gemini
GEMINI_API_KEY="your_gemini_key_here"
GOOGLE_API_KEY="your_google_key_here"

# Anthropic / Claude
# ANTHROPIC_API_KEY="sk-..."

# OpenAI
# OPENAI_API_KEY="sk-..."

# GitHub Token (if needed for extensive API use beyond CLI)
# GITHUB_TOKEN="..."

# --- System Configuration ---
# Directory where the agent box is installed
# Defaults to ~/agent-box if not set
# INSTALL_DIR="/home/pr-gemini/agent-box"


# Supervisor
# Minimum review rounds before auto-merge
MIN_REVIEW_ROUNDS=5

# How often the supervisor checks for PRs (in seconds)
SUPERVISOR_POLL_INTERVAL=300

# Hours before a PR with unresolved comments is considered stale
STALE_PR_HOURS=24

# --- Audit & Notifications ---
# Path for audit log (JSON Lines format)
AUDIT_LOG_PATH="audit.log"

# ntfy.sh topic for mobile push notifications
# Install ntfy app, subscribe to this topic, get instant notifications
# Leave empty to disable notifications
# NTFY_TOPIC="agent-box-yourname"