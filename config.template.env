# Agent Box Configuration

# --- GitHub Configuration ---
# The repository to monitor for issues
GITHUB_REPO="owner/repository_name"

# The GitHub user executing the agents
# (This is primarily for logging/logic, actual auth is handled by 'gh auth login')
GITHUB_USER="pr-gemini"

# Git Identity (for commits made by the agent)
GIT_NAME="Agent Gemini"
GIT_EMAIL="agent@example.com"

# --- Watcher Configuration ---
# How often to check for new issues (in seconds)
POLL_INTERVAL=60

# Directory where the agent will clone the repo and work
# Defaults to a 'workspace' folder inside the install dir if not absolute
WORK_DIR_BASE="workspace"

# --- Trigger Logic ---
# Label that triggers the agent
TRIGGER_LABEL="status:pending-agent"

# Label applied when agent starts working
WIP_LABEL="status:agent-working"

# Label applied when agent is done
DONE_LABEL="status:agent-done"

# Label applied if agent fails
ERROR_LABEL="status:agent-failed"

# --- Agent Command ---
# The command to execute when a job is found.
# Supported placeholders:
#   {issue_url}  - The full URL of the issue
#   {issue_number} - The issue number
#   {workspace_dir} - The directory where the repo is checked out
#
# Examples:
# AGENT_COMMAND="claude --print-architecture --issue {issue_url}"
# AGENT_COMMAND="antigravity run --issue {issue_url}"
AGENT_COMMAND="antigravity run --issue {issue_url}"

# --- Environment Secrets ---
# You can add API keys here for your agents
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
